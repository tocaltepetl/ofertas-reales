{
  "name": "buenfin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Catálogo de promociones y motor para encontrar la mejor forma de pagar en eventos de compras (Buen Fin, Hot Sale, ...)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "validar": "node src/cli.ts validar",
    "pendientes": "node src/cli.ts pendientes --escribir docs/pendientes.md",
    "evaluar": "node src/cli.ts evaluar",
    "build:web": "node scripts/build-web.ts",
    "web": "node scripts/build-web.ts && python3 -m http.server -b 127.0.0.1 -d web/dist 8766"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
